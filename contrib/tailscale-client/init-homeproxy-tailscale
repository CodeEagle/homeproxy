#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15

PROG=/mnt/data/homeproxy-tailscale/sing-box
CONF=/etc/homeproxy-tailscale/config.json
STATE_DIR=/mnt/data/homeproxy-tailscale/state
RUN_DIR=/mnt/data/homeproxy-tailscale
FIREWALL=/etc/homeproxy-tailscale/firewall.sh

start_service() {
	[ -x "$PROG" ] || {
		logger -t homeproxy-tailscale "missing executable: $PROG"
		return 1
	}
	[ -r "$CONF" ] || {
		logger -t homeproxy-tailscale "missing config: $CONF"
		return 1
	}

	mkdir -p "$RUN_DIR" "$STATE_DIR" || return 1
	chmod 700 "$RUN_DIR" "$STATE_DIR"

	"$PROG" check -c "$CONF" || {
		logger -t homeproxy-tailscale "sing-box config check failed"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONF"
	procd_set_param directory "$RUN_DIR"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 20
	procd_close_instance

	[ -x "$FIREWALL" ] && "$FIREWALL" reload
}

service_started() {
	# firewall.sh retries while hpts0 is present but not yet UP.
	[ -x "$FIREWALL" ] && "$FIREWALL" up
}

stop_service() {
	# Keep the policy table and blackhole in place: stopping is fail-closed.
	[ -x "$FIREWALL" ] && "$FIREWALL" down
}
